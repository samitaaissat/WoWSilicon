+
+
+/**********************************************************************
+ *		is_foreign_thread
+ *
+ * TRUE for a thread wine did not create. The d9mt renderer pulls Metal and
+ * libdispatch callback threads into the process, and wine's fault handlers
+ * assume every thread has a TEB and a syscall frame: handling a fault on one
+ * of those threads faults again inside the handler, so the thread dies with no
+ * stderr, no macOS crash report, and the process limps on in a degraded state.
+ *
+ * teb_key is the only thread-local wine sets on every thread it creates, so it
+ * is the reliable discriminator here — get_current_thread_data() derives the
+ * pointer by masking the stack pointer and happily returns garbage on a
+ * foreign thread.
+ */
+static inline BOOL is_foreign_thread(void)
+{
+    return !pthread_getspecific( teb_key );
+}
+
+
+/**********************************************************************
+ *		reraise_foreign_thread_fault
+ *
+ * Restores the default disposition for the fatal fault signals and returns.
+ * The faulting instruction then re-executes and the process dies the normal
+ * way, so macOS writes a crash report naming the real faulting frame instead
+ * of the fault vanishing without a trace.
+ */
+static void reraise_foreign_thread_fault(void)
+{
+    static const char msg[] =
+        "wine: fault on a thread not created by wine; restoring default handler so it gets reported\n";
+    struct sigaction act;
+
+    write( 2, msg, sizeof(msg) - 1 );
+
+    act.sa_handler = SIG_DFL;
+    act.sa_flags = 0;
+    sigemptyset( &act.sa_mask );
+    sigaction( SIGSEGV, &act, NULL );
+    sigaction( SIGBUS, &act, NULL );
+    sigaction( SIGILL, &act, NULL );
 }
 
 
